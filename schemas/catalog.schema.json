{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "organization",
        "catalog",
        "program",
        "dataset"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "un_relation": {
      "enum": [
        "UN_SYSTEM",
        "UN_RELATED",
        "UN_PARTNER",
        "INDEPENDENT"
      ]
    },
    "relation_note": {
      "type": "string",
      "minLength": 1
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "original_producer": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5",
          "A6",
          "B1",
          "B2",
          "B3",
          "B4",
          "B5",
          "B6",
          "B7",
          "B8"
        ]
      },
      "uniqueItems": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "data_levels": {
      "type": "array",
      "items": {
        "enum": [
          "aggregate",
          "microdata",
          "geospatial",
          "text_event"
        ]
      },
      "uniqueItems": true
    },
    "observation_units": {
      "type": "array",
      "items": {
        "enum": [
          "country",
          "region",
          "person",
          "household",
          "diary_day",
          "treaty",
          "event",
          "organization",
          "firm",
          "grid_cell"
        ]
      },
      "uniqueItems": true
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "single_country",
            "multi_country",
            "global"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "country_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "uniqueItems": true
        },
        "coverage_completeness": {
          "enum": [
            "complete",
            "partial",
            "not_enumerated"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scope",
        "regions",
        "country_codes",
        "coverage_completeness",
        "notes"
      ]
    },
    "time_coverage": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": [
        "string",
        "null"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "OPEN",
            "REGISTER",
            "APPLY",
            "REQUEST",
            "METADATA_ONLY",
            "PAID"
          ]
        },
        "free_data_available": {
          "type": "boolean"
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "web_download",
              "bulk_download",
              "api",
              "web_interface",
              "research_application",
              "email_request"
            ]
          },
          "uniqueItems": true
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "CSV",
              "JSON",
              "XML",
              "SDMX",
              "XLSX",
              "Stata",
              "SPSS",
              "SAS",
              "R",
              "PDF",
              "HTML",
              "DDI"
            ]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "license_name": {
          "type": "string",
          "minLength": 1
        },
        "license_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "required": [
        "status",
        "free_data_available",
        "methods",
        "formats",
        "notes",
        "license_name",
        "license_url"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "METADATA_ONLY",
                  "PAID"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "free_data_available": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "free_data_available": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rel": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "required": [
          "rel",
          "url"
        ]
      },
      "uniqueItems": true
    },
    "survey": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "weights": {
              "type": "string",
              "minLength": 1
            },
            "representativeness": {
              "type": "string",
              "minLength": 1
            },
            "comparability": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "method",
            "weights",
            "representativeness",
            "comparability"
          ]
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "discovered",
            "verified",
            "indexed"
          ]
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        },
        "method": {
          "enum": [
            "public_documentation",
            "download_test"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "claim"
            ]
          }
        }
      },
      "required": [
        "status",
        "checked_on",
        "method",
        "scope",
        "evidence"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "name",
    "description",
    "topics",
    "keywords",
    "verification"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boris-belyavskiy.github.io/open-global-data-atlas/downloads/catalog.schema.json",
  "title": "Open Global Data Atlas record v1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "organization"
          }
        }
      },
      "then": {
        "required": [
          "website",
          "un_relation",
          "relation_note"
        ]
      },
      "else": {
        "required": [
          "organization_id",
          "parent_id",
          "catalog_ids",
          "original_producer",
          "collector",
          "publisher",
          "data_levels",
          "observation_units",
          "geography",
          "time_coverage",
          "release",
          "access",
          "links",
          "survey"
        ]
      }
    }
  ]
}
